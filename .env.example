# Copy to .env and adjust. docker compose and run.sh both read it.
# Never commit .env: it holds your API key.

# --- LLM endpoint (Ollama API) ---
# Local Ollama: http://localhost:11434 (from Docker on Linux: http://host.docker.internal:11434)
# Ollama Cloud:  https://ollama.com    (always https: the key is sent in a header)
OLLAMA_HOST=http://host.docker.internal:11434
# Bearer token for an authenticated endpoint. Empty = no auth header.
OLLAMA_API_KEY=
# For an endpoint expecting e.g. "X-Api-Key: <key>", set the header and an empty scheme.
OLLAMA_AUTH_HEADER=Authorization
OLLAMA_AUTH_SCHEME=Bearer
# Default model for new projects; each project can pick its own in the UI.
OLLAMA_MODEL=gemma4:31b

# --- Throughput ---
LLM_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=0      # 0 = no client-side rate limit
LLM_REQUEST_TIMEOUT=180
LLM_CONNECT_TIMEOUT=10
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.5
LLM_MAX_CONTENT_CHARS=8000     # page text sent per call
LLM_NUM_PREDICT=500            # output token limit per call

# --- Spending guards (0 = off) ---
LLM_MAX_CALLS_PER_RUN=0        # hard ceiling on model calls per analysis run
LLM_STOP_AT_SESSION_USAGE=0    # e.g. 0.80: stop at 80% of a quota ollama.com reports

# --- Cost estimate (shown before each run; 0 = show calls and tokens only) ---
# Your endpoint's price in dollars per million tokens. Local Ollama: leave at 0.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0

# --- Server ---
PORT=8000
# Password for the web UI (HTTP Basic). Empty = no login at all, so set it
# whenever anyone but you can reach the port. The CLI is not affected.
DA_PASSWORD=
DA_USERNAME=archive
# Where the database, downloads, logs and exports live (docker compose mounts ./data).
# DA_DATA_DIR=/app/data
